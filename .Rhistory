##############################
########## 1. Setup ##########
##############################
# --------------------- #
##### 1.1 Libraries #####
# --------------------- #
library(httr)
library(jsonlite)
library(lhs)
library(dplyr)
library(dgpsi)
library(DBI)
library(RPostgres)
library(nloptr)
library(ggplot2)
# ------------------------------------- #
##### 1.2 Source all relevant files #####
# ------------------------------------- #
source("D:/jdd215/GitHub/FastFarm-ArableManagement/config_example.R")
# ------------------------------------- #
##### 1.3 User-specified parameters #####
# ------------------------------------- #
# a) Number of samples to test
n_samples <- 60
# b) Parcel ID - FOR DATA COLLECTION - ONLY USING PARCELS WITH ASSOCIATED YIELD DATA
available_parcels <- c(1652902, 5969854, 2007837, 5315941, 6155780, 3787634, 1994132, 927161, 2448843, 5011443, 1223633, 4999331, 5756123, 6575450, 4737102, 5520500, 254857, 6075848, 608837, 5289411, 1090199, 5394899, 6384863,
1089359, 1770854, 775327, 593924, 248604, 176342, 6392565, 597204, 6240087, 5233348, 3180706, 6635613, 2716041, 345408, 2338196, 2752533, 6240087, 4966596, 1138219, 2916085, 6313721, 4386266, 6042963,
43606, 4762467, 5935422, 1823506, 5756123, 3339486, 202549, 5967923, 1513437, 1994132, 4853136, 2338196, 1268149, 2465317)
parcels <- sample(available_parcels, size = n_samples, replace = TRUE)
# c) Year
# NOTE - This is the year in which harvest takes place. The 'crop calendar' will start in the previous year (i.e., the time which the previous crop was harvested)
harvest_years <- sample(2017:2050, size = n_samples, replace = TRUE)
# d) Crop
# Options: "winter_wheat", "maize", "winter_barley", "winter_oats", "fallow", "rapeseed", "rye_grass", "potato", "spring_barley", "spring_oats", "spring_wheat", "fababean"
crop_options <- c("winter_wheat", "maize", "winter_barley", "winter_oats", "rapeseed", "potato", "spring_barley", "spring_oats", "spring_wheat")
crops <- sample(crop_options, size = n_samples, replace = TRUE)
# e) Number of optimisation iterations
n_opt_it <- 30
# f) Whether to fix PAVAILI and KAVAILI to a default value (set in params_other)
# If true, PAVAILI and KAVAILI are set to a fixed value. If false, they are included in the LHS sample.
fix_P_K <- TRUE
# g) Set directory for outputs
out_dir <- "D:/jdd215/Data/Farm Model/Arable Management/Optimisation Tests/"
# g) Set name of SQL table for outputs
out_tbl <- "opt_results.opt_results_test1"
profvis(fcn_call_optimiser_1yr(
c(6075848),
c(2021),
c("winter_wheat"),
n_opt_it = n_opt_it,
out_dir = out_dir,
out_tbl = out_tbl,
wofost_url = wofost_url,
conn_ff = conn_ff,
fix_P_K = fix_P_K))
library(profvis)
profvis(fcn_call_optimiser_1yr(
c(6075848),
c(2021),
c("winter_wheat"),
n_opt_it = n_opt_it,
out_dir = out_dir,
out_tbl = out_tbl,
wofost_url = wofost_url,
conn_ff = conn_ff,
fix_P_K = fix_P_K))
rm(list=ls())
